<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ extraction rules: no cloud backup, no device-to-device transfer
     of any app data. Same reasoning as backup_rules.xml — a database without
     its non-exportable key is dead weight, and the preferences hold nothing
     that should ever leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
