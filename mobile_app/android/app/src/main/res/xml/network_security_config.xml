<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is disabled platform-wide (release). The debug overlay
     manifest re-enables it for loopback/LAN development only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
