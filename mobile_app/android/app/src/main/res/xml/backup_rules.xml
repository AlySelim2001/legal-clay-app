<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy full-backup rules (API < 31). The encrypted DB is useless without
     its Keystore-bound key, and keystores are non-exportable — so back up
     nothing sensitive at all. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
