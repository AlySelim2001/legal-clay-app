# CRIM-SYS 2026 — signing & secrets template
#
# Copy this file to keystore.properties (same directory) and fill in real
# values. keystore.properties is git-ignored and must NEVER be committed.
#
#   cp keystore.properties.example keystore.properties
#
# ── Release signing ────────────────────────────────────────────────────────
# Generate the keystore once (keep crimsys-release.jks OFF the repo too —
# only the path below is read at build time):
#
#   keytool -genkeypair -v \
#     -keystore crimsys-release.jks \
#     -alias crimsys \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to android/ (the Gradle root).
storeFile=crimsys-release.jks
storePassword=CHANGE_ME
keyAlias=crimsys
keyPassword=CHANGE_ME

# ── Optional backend secrets (offline-first: app runs fine without these) ──
# Values here are surfaced as BuildConfig fields (see app/build.gradle.kts).
# firestoreProjectId=
# syncEnabled=true
