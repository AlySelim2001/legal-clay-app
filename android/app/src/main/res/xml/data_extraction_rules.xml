<?xml version="1.0" encoding="utf-8"?>
<!--
  data-extraction-rules (Android 12+). Same rationale as backup_rules.xml:
  the passphrase blob in crimsys_security.xml is wrapped by the local
  Keystore — restoring it on new hardware yields an undecryptable database.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="crimsys.db" />
        <exclude domain="database" path="crimsys.db-wal" />
        <exclude domain="database" path="crimsys.db-shm" />
        <exclude domain="sharedpref" path="crimsys_security.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="crimsys.db" />
        <exclude domain="database" path="crimsys.db-wal" />
        <exclude domain="database" path="crimsys.db-shm" />
        <exclude domain="sharedpref" path="crimsys_security.xml" />
    </device-transfer>
</data-extraction-rules>
