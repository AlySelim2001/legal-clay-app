<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup rules: sync Room database (case data) but exclude
    the unencrypted DataStore of UI preferences only.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
