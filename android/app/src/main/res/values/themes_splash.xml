<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Splash theme required by androidx.core.splashscreen on pre-API-31.
      Hands control back to Theme.CrimSys once the splash is dismissed.
    -->
    <style name="Theme.CrimSys.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/clay_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.CrimSys</item>
    </style>
</resources>
