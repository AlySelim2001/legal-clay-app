        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "يومياً 06:30 (Cairo)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://court-scraper:8400/scrape",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ keyword: $env.SCRAPE_KEYWORD, limit: 5, source: \"cassation\" }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Scrape Court Site",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Flatten scrape results into items and drop already-seen URLs.\nconst seen = $getWorkflowStaticData('global');\nseen.urls = Array.isArray(seen.urls) ? seen.urls : [];\nconst seenSet = new Set(seen.urls);\nconst out = [];\nfor (const item of items) {\n  for (const r of item.json.results || []) {\n    if (!r.url || seenSet.has(r.url)) continue;\n    seenSet.add(r.url);\n    out.push({ json: r });\n  }\n}\n// Cap the memory footprint of the static store.\nseen.urls = Array.from(seenSet).slice(-500);\nreturn out;"
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Split + Dedupe",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://presidio-scrubber:8100/scrub",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text, operator: \"redact\" }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Scrub PII (Presidio)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-scrub-clean",
              "leftValue": "={{ $json.risk }}",
              "rightValue": "blocked",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            },
            {
              "id": "cond-scrub-nonempty",
              "leftValue": "={{ ($json.scrubbed_text || '').length }}",
              "rightValue": "50",
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Scrub OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [880, 0]
