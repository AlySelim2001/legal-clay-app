    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Assemble the channel message with the MANDATORY disclaimer.\nconst esc = (s) => String(s ?? '')\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;');\nconst item = $json;\nconst DISCLAIMER =\n  '⚠️ إخلاء مسؤولية إلزامي: هذا المحتوى مُولّد آلياً كأداة تنظيمية مساعدة، ' +\n  'ولا يُغني بأي حال عن الاستشارة القانونية أو مراجعة ملف القضية الأصلي. ' +\n  '— CRIM-SYS 2026';\nconst message = [\n  '📄 <b>' + esc(item.title) + '</b>',\n  '🔗 ' + esc(item.url),\n  '',\n  '⚖️ <b>التحليل القانوني المبسط:</b>',\n  esc(item.answer).slice(0, 3000),\n  '',\n  DISCLAIMER,\n].join('\\n');\nreturn { json: { message } };"
      },
      "id": "a1b2c3d4-0008-4000-8000-000000000008",
      "name": "Build Message + Disclaimer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, -100]
    },
    {
      "parameters": {
