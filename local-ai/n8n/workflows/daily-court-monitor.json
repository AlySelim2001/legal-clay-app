        "options": {
          "timeout": 300000
        }
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Analyze (CrewAI + RAG)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 0],
